# Copy to .env for local development. On Netlify, set these under
# Site configuration → Environment variables instead.

# --- Supabase (Project Settings → API) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or the legacy "anon" key
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# Server-only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx            # or the legacy "service_role" key

# --- AI provider (any OpenAI-compatible Chat Completions API) ---
# Anthropic (Claude):
AI_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=sk-ant-xxx
AI_MODEL=claude-sonnet-5-5
# OpenAI:        AI_BASE_URL=https://api.openai.com/v1
# Google Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Notion (optional: shared read-only "mockup" roles) ---
# Create an internal integration at https://www.notion.so/my-integrations and
# share the mockup-role pages with it. Leave empty to turn mockup roles off.
NOTION_API_KEY=
